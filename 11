function spawn(b,initial=false){const seed=b.id+serial++*31;const cols=w<700?4:7,rows=Math.ceil((w<700?20:35)/cols);b.x=w*((b.id%cols+.22+rnd(seed)*.56)/cols);b.y=h*((Math.floor(b.id/cols)+.18+rnd(seed+3)*.6)/rows);b.homeX=b.x;b.homeY=b.y;b.size=(w<700?14:17)+rnd(seed+5)*12;b.age=initial?2+rnd(seed+10)*9:0;b.duration=12+rnd(seed+8)*12;b.alpha=initial?.18:0;b.mode='rest';b.seed=seed;b.angle=(rnd(seed+9)-.5)*.8;b.trail=[];b.wait=0}
function resize(){const oldW=w,oldH=h;w=innerWidth;h=innerHeight;const d=Math.min(devicePixelRatio||1,1.6);canvas.width=w*d;canvas.height=h*d;ctx.setTransform(d,0,0,d,0,0);const count=w<700?20:35;if(flock.length!==count){flock=Array.from({length:count},(_,id)=>{const b={id};spawn(b,true);return b})}else if(oldW&&oldH){for(const b of flock){b.x*=w/oldW;b.y*=h/oldH;b.homeX*=w/oldW;b.homeY*=h/oldH;b.trail=[]}}}
function scatter(){if(paused||document.hidden)return;lastScroll=time;for(const b of flock){if(b.mode!=='rest')continue;b.mode='flight';b.age=0;b.launchAlpha=b.alpha;b.vx=(b.x<w/2?-1:1)*(35+rnd(b.seed+22)*65);b.vy=-(65+rnd(b.seed+23)*95);b.delay=rnd(b.seed+24)*.16;b.trail=[]}start()}
function update(b,dt){b.age+=dt;if(b.mode==='rest'){b.alpha=.20*ease(b.age/1.8)*(1-ease((b.age-b.duration+2.5)/2.5));b.x=b.homeX+Math.sin(time*.25+b.seed)*3;b.y=b.homeY+Math.sin(time*.32+b.seed)*3;if(b.age>b.duration){b.mode='wait';b.wait=1+rnd(b.seed+32)*2.5;b.age=0}}
else if(b.mode==='flight'){if(b.age<b.delay)return;b.trail.unshift({x:b.x,y:b.y});if(b.trail.length>7)b.trail.pop();b.x+=(b.vx+Math.sin(time*5+b.seed)*24)*dt;b.y+=b.vy*dt;b.vy-=36*dt;b.angle=lerp(b.angle,Math.atan2(b.vy,b.vx)+Math.PI/2,.08);b.alpha=b.launchAlpha*(1-ease((b.age-1.5)/1.6));if(b.y< -100||b.x< -100||b.x>w+100||b.age>3.2){b.mode='wait';b.age=0;b.wait=.5+rnd(b.seed+13)*2.5;b.alpha=0;b.trail=[]}}
else if(time-lastScroll>1.3&&b.age>b.wait)spawn(b)}
