const source=document.getElementById('flock-artwork');let texture=null;
function prepareArtwork(){
 const c=document.createElement('canvas');c.width=470;c.height=836;const g=c.getContext('2d',{willReadFrequently:true});g.drawImage(source,0,0,c.width,c.height);
 const data=g.getImageData(0,0,c.width,c.height),p=data.data;
 for(let y=0;y<c.height;y++){
  let bg=0;for(let x=5;x<25;x++){let k=(y*c.width+x)*4;bg+=(p[k]+p[k+1]+p[k+2])/3}bg/=20;
  for(let x=0;x<c.width;x++){let k=(y*c.width+x)*4;const lum=(p[k]+p[k+1]+p[k+2])/3;const strength=clamp((bg-lum-4)/44);const gold=p[k]-p[k+2]>9;p[k]=gold?181:116;p[k+1]=gold?157:122;p[k+2]=gold?112:128;p[k+3]=Math.round(strength*255)}
 }
 g.putImageData(data,0,0);texture=c;paint();
}
function butterfly(b){if(!texture||b.alpha<.01)return;const flying=b.mode==='flight';
 ctx.save();ctx.translate(b.x,b.y);ctx.rotate(b.angle);
 const flap=flying?.4+.6*Math.abs(Math.sin(time*8+b.seed)):.96+.04*Math.sin(time*1.2+b.seed);
 ctx.globalAlpha=b.alpha;const width=b.size*2.05,height=width*1.48;
 // Only the wing width folds during flight. No invented contours, fill or antennae.
 ctx.drawImage(texture,33,125,407,604,-width*flap/2,-height/2,width*flap,height);
 ctx.restore();
}
function paint(dt=0){ctx.clearRect(0,0,w,h);for(let i=0;i<(w<700?38:60);i++){const x=(rnd(i+610)*w+Math.sin(time*.14+i)*13+w)%w,y=(rnd(i+901)*h-time*2+h*100)%h;ctx.fillStyle=`rgba(174,179,184,${.065+Math.sin(time*.4+i)*.02})`;ctx.beginPath();ctx.arc(x,y,.5+rnd(i+721)*.7,0,TAU);ctx.fill()}for(const b of flock){if(dt)update(b,dt);butterfly(b)}}
function tick(now){frame=0;if(paused||document.hidden)return;if(last&&now-last<32){frame=requestAnimationFrame(tick);return}const dt=last?Math.min((now-last)/1000,.065):0;last=now;time+=dt;paint(dt);frame=requestAnimationFrame(tick)}
function start(){if(!frame&&!paused&&!document.hidden){last=0;frame=requestAnimationFrame(tick)}}
function state(){toggle.textContent=paused?'播放蝶群动效':'暂停蝶群动效';toggle.setAttribute('aria-pressed',String(!paused));if(paused){cancelAnimationFrame(frame);frame=0;paint()}else start()}
toggle.addEventListener('click',()=>{paused=!paused;state()});mq.addEventListener('change',e=>{paused=e.matches;state()});document.addEventListener('visibilitychange',()=>{if(document.hidden){cancelAnimationFrame(frame);frame=0}else start()});addEventListener('resize',()=>{resize();paint()});
// Listen passively: never intercept normal page scrolling, buttons or the design slider.
addEventListener('scroll',()=>{const y=scrollY;if(Math.abs(y-scrollPos)>1)scatter();scrollPos=y},{passive:true});
addEventListener('touchstart',e=>{touchY=e.touches.length===1?e.touches[0].clientY:null},{passive:true});
addEventListener('touchmove',e=>{if(touchY===null||e.touches.length!==1)return;const y=e.touches[0].clientY;if(Math.abs(touchY-y)>9){scatter();touchY=y}},{passive:true});addEventListener('touchend',()=>{touchY=null},{passive:true});addEventListener('touchcancel',()=>{touchY=null},{passive:true});
addEventListener('wheel',e=>{if(Math.abs(e.deltaY)>2&&!e.ctrlKey)scatter()},{passive:true});resize();paint();state();if(source.complete&&source.naturalWidth)prepareArtwork();else source.addEventListener("load",prepareArtwork,{once:true});
})();
</script></body></html>
