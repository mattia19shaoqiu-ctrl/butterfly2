(()=>{'use strict';document.documentElement.classList.add('js');const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;const img=document.getElementById('main-image');const hc=document.getElementById('hero-canvas'),gc=document.getElementById('generate-canvas');const hctx=hc.getContext('2d'),gctx=gc.getContext('2d');let start=0,raf=0,visible=true,point={x:-1000,y:-1000},current=0;const range=document.getElementById('evolution');const ease=t=>1-Math.pow(1-Math.max(0,Math.min(1,t)),3);function fit(c){const r=c.getBoundingClientRect(),d=Math.min(devicePixelRatio||1,2);c.width=Math.round(r.width*d);c.height=Math.round(r.height*d);return{w:c.width,h:c.height,d}}let H,G;function rect(c){const scale=Math.min(c.w/img.naturalWidth,c.h/img.naturalHeight);return{x:(c.w-img.naturalWidth*scale)/2,y:(c.h-img.naturalHeight*scale)/2,w:img.naturalWidth*scale,h:img.naturalHeight*scale}}function hero(now){raf=0;if(!visible||document.hidden||!H||!img.naturalWidth)return;const t=reduce?9:((now-start)/1000)%14,r=rect(H);hctx.clearRect(0,0,H.w,H.h);const rows=240,sh=img.naturalHeight/rows;for(let i=0;i<rows;i++){const v=i/rows,p=ease((t-.4-v*1.5)/2.4)*(reduce?1:1-ease((t-10-v*.8)/2.4));if(p<=0)continue;const yy=r.y+i*r.h/rows,near=Math.max(0,1-Math.abs(yy-point.y)/95/H.d),dx=Math.sin(i*.32+now*.001)*near*2*H.d;hctx.globalAlpha=p;hctx.drawImage(img,0,i*sh,img.naturalWidth,sh,r.x+(1-p)*Math.sin(i*4.1)*H.w*.35+dx,yy,r.w,r.h/rows+.5)}hctx.globalAlpha=1;if(t<2.3){hctx.strokeStyle='#b4b4b0';hctx.lineWidth=H.d*.5;hctx.beginPath();hctx.moveTo(H.w*.18,H.h*.5);hctx.lineTo(H.w*(.18+.64*ease(t)),H.h*.5);hctx.stroke()}if(point.x>0&&t>2.5){hctx.save();hctx.globalCompositeOperation='soft-light';const glow=hctx.createRadialGradient(point.x,point.y,0,point.x,point.y,130*H.d);glow.addColorStop(0,'rgba(255,255,255,.9)');glow.addColorStop(1,'rgba(255,255,255,0)');hctx.fillStyle=glow;hctx.fillRect(0,0,H.w,H.h);hctx.restore()}if(!reduce)raf=requestAnimationFrame(hero)}function schedule(){if(!raf&&visible&&!document.hidden)raf=requestAnimationFrame(hero)}function generation(){if(!G||!img.complete)return;const t=current/100,r=rect(G);gctx.clearRect(0,0,G.w,G.h);const rows=180,sh=img.naturalHeight/rows;for(let i=0;i<rows;i++){let y=r.y+i*r.h/rows;const p=ease(t*1.4);const spread=(1-p)*Math.sin(i*1.91)*G.w*.27;gctx.globalAlpha=.25+.75*p;gctx.drawImage(img,0,i*sh,img.naturalWidth,sh,r.x+spread,y+(1-p)*Math.cos(i*.8)*18*G.d,r.w,r.h/rows+.4)}gctx.globalAlpha=1;if(t<.65){gctx.strokeStyle='#9da2a5';gctx.lineWidth=G.d*.6;gctx.globalAlpha=(1-t/.65)*.8;for(let i=0;i<35;i++){let y=G.h*.2+i*G.h*.017;gctx.beginPath();gctx.moveTo(G.w*.17,y);gctx.lineTo(G.w*.83,y);gctx.stroke()}gctx.globalAlpha=1}const step=t<.33?0:t<.75?1:2;document.querySelectorAll('.step').forEach((s,i)=>s.classList.toggle('active',i===step));document.getElementById('stage-state').textContent=['01 / STITCH','02 / STRUCTURE','03 / REFLECTION'][step]}function resize(){H=fit(hc);G=fit(gc);generation();schedule()}function init(){resize();document.querySelector('.hero-art').classList.add('ready');start=performance.now();schedule()}if(img.complete&&img.naturalWidth)init();else img.addEventListener('load',init,{once:true});window.addEventListener('resize',resize);document.addEventListener('visibilitychange',()=>{if(document.hidden){cancelAnimationFrame(raf);raf=0}else{start=performance.now();schedule()}});range.addEventListener('input',()=>{current=+range.value;generation()});document.getElementById('replay').addEventListener('click',()=>{start=performance.now();schedule()});document.querySelector('.hero').addEventListener('pointermove',e=>{if(reduce)return;const r=hc.getBoundingClientRect();point={x:(e.clientX-r.left)*H.d,y:(e.clientY-r.top)*H.d};schedule()});document.querySelector('.hero').addEventListener('pointerleave',()=>{point.x=-1000;schedule()});document.querySelector('.hero').addEventListener('pointerup',()=>{point.x=-1000;schedule()});new IntersectionObserver(es=>{const returning=!visible&&es[0].isIntersecting;visible=es[0].isIntersecting;if(returning)start=performance.now();if(visible)schedule()},{threshold:0}).observe(hc);const obs=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('shown');obs.unobserve(e.target)}})},{threshold:.08});document.querySelectorAll('.reveal').forEach(e=>obs.observe(e));let scrolling=false;function scroll(){const max=document.documentElement.scrollHeight-innerHeight;document.querySelector('.progress').style.transform='scaleX('+(max>0?scrollY/max:0)+')';if(!reduce){document.querySelector('.hero-art').style.translate='0 '+Math.min(scrollY*.1,70)+'px'}scrolling=false}addEventListener('scroll',()=>{if(!scrolling){scrolling=true;requestAnimationFrame(scroll)}},{passive:true});scroll();document.querySelectorAll('[data-material]').forEach(b=>b.addEventListener('click',()=>{const emb=b.dataset.material==='emboss';document.getElementById('packages').classList.toggle('emboss',emb);document.querySelectorAll('[data-material]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));document.getElementById('material-description').textContent=emb?'暖白棉纸 × 无色压印 × 低反射肌理':'哑光米白纸 × 冷银烫印 × 局部浅金'}));})();
</script><script>(()=>{'use strict';
const canvas=document.getElementById('silk-background'),ctx=canvas.getContext('2d'),toggle=document.getElementById('motion-toggle'),mq=matchMedia('(prefers-reduced-motion: reduce)');
